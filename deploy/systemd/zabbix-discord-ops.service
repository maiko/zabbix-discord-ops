[Unit]
Description=Tenant-aware Zabbix operations for Discord
Documentation=https://github.com/maiko/zabbix-discord-ops
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=zabbix-discord-ops
StateDirectoryMode=0700
ExecStart=/usr/local/bin/zabbix-discord-ops -config /etc/zabbix-discord-ops/config.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
UMask=0077

LoadCredentialEncrypted=discord-bot-token:/etc/credstore.encrypted/zabbix-discord-ops.discord-bot-token
LoadCredentialEncrypted=discord-public-key:/etc/credstore.encrypted/zabbix-discord-ops.discord-public-key
LoadCredentialEncrypted=zabbix-api-token:/etc/credstore.encrypted/zabbix-discord-ops.zabbix-api-token
LoadCredentialEncrypted=ingest-token:/etc/credstore.encrypted/zabbix-discord-ops.ingest-token
LoadCredentialEncrypted=component-signing-key:/etc/credstore.encrypted/zabbix-discord-ops.component-signing-key

AmbientCapabilities=
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateIPC=yes
PrivateMounts=yes
PrivateTmp=yes
ProcSubset=pid
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
